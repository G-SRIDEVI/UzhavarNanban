# UzhavarNanban Environment Configuration Example
# Copy this file to .env and adjust variables as needed

APP_ENV=development
APP_NAME=UzhavarNanban
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database: SQLite default for local zero-config, PostgreSQL for production
# For Postgres: postgresql://user:password@localhost:5432/uzhavarnanban
DATABASE_URL=sqlite:///./uzhavarnanban.db

# JWT Security
SECRET_KEY=uzhavar_nanban_secret_jwt_key_2026_natrampalli_tirupattur
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Vision Service (simulated mode with TNAU plant pathology engine if no remote key)
AI_VISION_API_KEY=
AI_SIMULATED_MODE=True

# Payment Gateway Sandbox
PAYMENT_GATEWAY_KEY=rzp_test_uzhavar_demo_key
PAYMENT_GATEWAY_SECRET=rzp_test_secret_demo
PAYMENT_SANDBOX_MODE=True

# Upload Directory
UPLOAD_DIR=./uploads
